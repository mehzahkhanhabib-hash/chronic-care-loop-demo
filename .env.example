# Copy to .env (optional). Every value has a working default.
PORT=4000                      # Express backend
STUDIO_PORT=3000               # Chronic Care Studio (webpack dev server)
PORTAL_PORT=3001               # Care Coordinator Portal (webpack dev server)
CCL_DB_DIR=./data/db           # where claims.sqlite and ccl.sqlite live
CCL_RUN_DATE=2026-11-20        # the demo "today" used by the rule engine and worklist
CCL_AS_OF=2026-10-31           # date the longitudinal extract was computed for (date columns are measured against it)
CCL_TRIGGER_VARIANT=rulebook   # rulebook = evaluate thresholds from the rulebook; extract = trust the Trig*_ flag columns
